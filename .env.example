# 复制为 .env.local 后填写实际地址；真实环境地址不提交到 Git。

# 本地 API 代理目标（同时影响桌面端统一认证跳转地址的回退值）。
VITE_API_PROXY_TARGET=

# 移动端 API 基地址；本地开发保持 /api 走代理即可。
VITE_API_BASE_URL=/api

# 桌面端统一认证（CAS）跳转源，默认使用代理目标或当前站点。
VITE_AUTH_ORIGIN=

# 移动端图片 CDN 基地址（可选）。
# VITE_IMAGE_BASE_URL=

# 移动端分享链接的前端基地址（可选，默认当前源）。
# VITE_FRONTEND_BASE_URL=
